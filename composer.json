{
    "name": "pamel/elearning-lms",
    "description": "Sistema LMS ligero para PAMEL Maritime Training Center",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ezyang/htmlpurifier": "^4.19",
        "phpmailer/phpmailer": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
